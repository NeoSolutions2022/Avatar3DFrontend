# Porta publicada no computador/servidor.
AVATAR3D_HTTP_PORT=8080

# Nome opcional da imagem Docker.
AVATAR3D_IMAGE=neotalk/avatar3d:local

# Origens separadas por virgula. Use a URL do front-end que enviara poses.
AVATAR3D_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Sites autorizados a incorporar /widget e enviar comandos via postMessage.
# Em producao, informe origens exatas e nunca inclua caminhos.
AVATAR3D_WIDGET_ORIGINS=http://localhost:3000,http://localhost:8080
# Opcional: velocidade de execucao da ELIA no modo apresentacao. Faixa0.5..1.5.
# Vazio mantem a configuracao do Unity (atualmente1.2). 1.5 e25%mais rapido.
# Alterar exige reiniciar/reimplantar o servico, nao recompilar o WebGL.34+.
AVATAR3D_ELIA_PLAYBACK_SPEED=
# Opcional: liberdade visual de bracos/maos/dedos no Evento Ultra, de0a1.
# Comece com0.5;0retorna ao envelope anterior. Vazio preserva valorUnity.
# Requer UM novo buildWebGL com SetEliaLectureFreedom e manifesto compativel;
# a build.34NAOtem esse comando. Depois ajustar soenv+reiniciar+recarregar.
AVATAR3D_ELIA_PRESENTATION_FREEDOM=

# Se preenchida, POST e DELETE exigem o header X-API-Key.
AVATAR3D_API_KEY=

# Limites de seguranca.
AVATAR3D_MAX_POSE_BYTES=20971520
AVATAR3D_MAX_POSE_FRAMES=10000

# Preserva o arquivo recebido sem alterar coordenadas ou formatacao.
AVATAR3D_KEEP_ORIGINALS=true

AVATAR3D_LOG_LEVEL=info

# Integracao do chat /mvp. Defina a chave apenas no servidor.
NEOTALK_API_BASE_URL=https://infra-neotalk-api.k3p3ex.easypanel.host
NEOTALK_API_KEY=
NEOTALK_API_TIMEOUT_SECONDS=30
NEOTALK_MVP_POSE_FPS=30
